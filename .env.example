# Copia este archivo como .env.local para trabajar en tu computadora,
# y pon los mismos valores en Vercel → Settings → Environment Variables.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-clave-anon-publica

# Dirección pública del sitio (sin barra final)
NEXT_PUBLIC_SITE_URL=https://silaba.io

# OpenAlex (gratis): openalex.org → crear cuenta → Settings → API key
OPENALEX_API_KEY=
